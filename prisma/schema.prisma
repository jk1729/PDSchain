generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Phase 1 minimal system foundation table used to verify migration state.
/// Domain models (Users, Roles, Districts, Warehouses, RationShops, Beneficiaries, Allocations)
/// belong to subsequent phases.
model SystemCheckpoint {
  id          String   @id @default(uuid()) @db.Uuid
  phase       Int      @unique
  label       String   @db.VarChar(120)
  initialized DateTime @default(now()) @map("initialized_at") @db.Timestamptz(6)

  @@map("system_checkpoints")
}

