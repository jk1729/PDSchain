generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Phase 1 minimal system foundation table used to verify migration state.
model SystemCheckpoint {
  id          String   @id @default(uuid()) @db.Uuid
  phase       Int      @unique
  label       String   @db.VarChar(120)
  initialized DateTime @default(now()) @map("initialized_at") @db.Timestamptz(6)

  @@map("system_checkpoints")
}

/// Canonical roles for PDSChain v2 Phase 2+
enum CanonicalRole {
  CITIZEN
  FPS_OPERATOR
  WAREHOUSE_MANAGER
  DISTRICT_OFFICER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum StaffRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id               String        @id @default(uuid()) @db.Uuid
  email            String        @unique @db.VarChar(255)
  fullName         String        @map("full_name") @db.VarChar(120)
  passwordHash     String        @map("password_hash") @db.Text
  emailVerifiedAt  DateTime?     @map("email_verified_at") @db.Timestamptz(6)
  status           AccountStatus @default(ACTIVE)
  suspendedAt      DateTime?     @map("suspended_at") @db.Timestamptz(6)
  suspensionReason String?       @map("suspension_reason") @db.VarChar(500)
  termsAcceptedAt  DateTime      @map("terms_accepted_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  roleAssignments     UserRoleAssignment[]     @relation("UserAssignments")
  grantedAssignments  UserRoleAssignment[]     @relation("GrantedByAdmin")
  revokedAssignments  UserRoleAssignment[]     @relation("RevokedByAdmin")
  sessions            Session[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  staffRequests       StaffAccessRequest[]     @relation("RequestedByUser")
  reviewedRequests    StaffAccessRequest[]     @relation("ReviewedByAdmin")
  auditEventsAsActor  SecurityAuditEvent[]     @relation("AuditActor")
  auditEventsAsTarget SecurityAuditEvent[]     @relation("AuditTargetUser")

  @@index([status])
  @@map("users")
}

model UserRoleAssignment {
  id                   String        @id @default(uuid()) @db.Uuid
  userId               String        @map("user_id") @db.Uuid
  role                 CanonicalRole
  districtCode         String?       @map("district_code") @db.VarChar(64)
  warehouseCode        String?       @map("warehouse_code") @db.VarChar(64)
  shopCode             String?       @map("shop_code") @db.VarChar(64)
  grantedById          String?       @map("granted_by_id") @db.Uuid
  grantedFromRequestId String?       @unique @map("granted_from_request_id") @db.Uuid
  revokedAt            DateTime?     @map("revoked_at") @db.Timestamptz(6)
  revokedById          String?       @map("revoked_by_id") @db.Uuid
  revocationReason     String?       @map("revocation_reason") @db.VarChar(500)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user               User                @relation("UserAssignments", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy          User?               @relation("GrantedByAdmin", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy          User?               @relation("RevokedByAdmin", fields: [revokedById], references: [id], onDelete: SetNull)
  grantedFromRequest StaffAccessRequest? @relation(fields: [grantedFromRequestId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([role, districtCode, warehouseCode, shopCode])
  @@map("user_role_assignments")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.VarChar(128)
  csrfTokenHash String    @map("csrf_token_hash") @db.VarChar(128)
  ipAddress     String?   @map("ip_address") @db.VarChar(64)
  userAgent     String?   @map("user_agent") @db.VarChar(255)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastActiveAt  DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@map("password_reset_tokens")
}

model StaffAccessRequest {
  id            String             @id @default(uuid()) @db.Uuid
  requesterId   String             @map("requester_id") @db.Uuid
  requestedRole CanonicalRole      @map("requested_role")
  districtCode  String             @map("district_code") @db.VarChar(64)
  warehouseCode String?            @map("warehouse_code") @db.VarChar(64)
  shopCode      String?            @map("shop_code") @db.VarChar(64)
  justification String             @db.VarChar(1000)
  status        StaffRequestStatus @default(PENDING)
  reviewerId    String?            @map("reviewer_id") @db.Uuid
  reviewedAt    DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  reviewNotes   String?            @map("review_notes") @db.VarChar(1000)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  requester          User                @relation("RequestedByUser", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer           User?               @relation("ReviewedByAdmin", fields: [reviewerId], references: [id], onDelete: SetNull)
  grantedRoleRecord  UserRoleAssignment?

  @@index([requesterId, status])
  @@index([status, createdAt])
  @@map("staff_access_requests")
}

model SecurityAuditEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  eventType          String   @map("event_type") @db.VarChar(80)
  outcome            String   @db.VarChar(32)
  actorUserId        String?  @map("actor_user_id") @db.Uuid
  targetUserId       String?  @map("target_user_id") @db.Uuid
  targetResourceType String?  @map("target_resource_type") @db.VarChar(64)
  targetResourceId   String?  @map("target_resource_id") @db.VarChar(128)
  ipAddress          String?  @map("ip_address") @db.VarChar(64)
  correlationId      String?  @map("correlation_id") @db.VarChar(128)
  metadata           Json?    @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actorUser  User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("security_audit_events")
}
