# ==============================================================================
# PDSChain v2 — Environment Configuration Template (Phase 1 & Phase 2)
# Copy this file to .env for local development:
#   PowerShell: Copy-Item .env.example .env
#   Bash/Zsh:   cp .env.example .env
# NEVER commit a populated .env file or real secrets to version control.
# ==============================================================================

# Application Environment (development | test | production)
NODE_ENV=development
APP_NAME=pdschain-v2
LOG_LEVEL=info

# Backend API Server Configuration
API_HOST=127.0.0.1
API_PORT=4000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Web Application Configuration
WEB_HOST=127.0.0.1
WEB_PORT=5173
WEB_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000/api/v1

# PostgreSQL Database Configuration (Local Development)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=pdschain
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DEV_PASSWORD
POSTGRES_DB=pdschain_v2
DATABASE_URL=postgresql://pdschain:CHANGE_ME_LOCAL_DEV_PASSWORD@127.0.0.1:5432/pdschain_v2?schema=public

# Session & Cookie Security (Phase 2)
SESSION_COOKIE_NAME=pdschain_session
CSRF_COOKIE_NAME=pdschain_csrf
SESSION_TTL_HOURS=24
SESSION_COOKIE_SECURE=false

# Argon2id Password Hashing Parameters (Phase 2)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Email Verification & Password Reset Lifetimes (Phase 2)
EMAIL_VERIFICATION_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30

# Rate Limiting for Sensitive Auth Endpoints (Phase 2)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_ATTEMPTS=10

# Email Delivery Mode (dev_outbox | smtp | disabled)
# Note: dev_outbox is strictly prohibited when NODE_ENV=production.
EMAIL_DELIVERY_MODE=dev_outbox
EMAIL_DEV_OUTBOX_DIR=.dev-mailbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@pdschain.example.org

# One-Time Administrator Bootstrap Variables (Phase 2 CLI only — never hardcoded)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FULL_NAME=

# Local Blockchain Workspace (Hardhat)
HARDHAT_RPC_URL=http://127.0.0.1:8545
HARDHAT_CHAIN_ID=31337

# Optional Future External Network Placeholders (Phase 3+ — DO NOT populate with real keys in repo)
SEPOLIA_RPC_URL=
SEPOLIA_CHAIN_ID=11155111
DEPLOYER_PRIVATE_KEY=
